+template <typename E, size_t Pout, typename V, int... m>
+KFR_INTRINSIC gcc_vec<E, Pout> gcc_permute_single(const V& a, const V& b, gcc_indices<m...>);
+
+// permutation of two native vectors of the same type
+template <typename E, size_t Pout, typename V, int... m>
+KFR_INTRINSIC gcc_vec<E, Pout> gcc_permute(const V& a, const V& b, gcc_indices<m...>)
+{
+    if constexpr (Pout == 4 && gcc_lanes<V> == 4 && sizeof(E) == 4)
+    {
+        using P                  = gcc_perm4<m...>;
+        constexpr gcc_perm4_plan plan = P::plan;
+        if constexpr (!plan.direct)
+        {
+            const V t = gcc_permute_single<E, 4>(plan.u ? b : a, plan.v ? b : a,
+                                                 gcc_indices<P::plan.op1[0], P::plan.op1[1], P::plan.op1[2],
+                                                             P::plan.op1[3]>{});
+            return gcc_permute_single<E, 4>(plan.s1 == 0 ? a : plan.s1 == 1 ? b : t,
+                                            plan.s2 == 0 ? a : plan.s2 == 1 ? b : t,
+                                            gcc_indices<P::plan.op2[0], P::plan.op2[1], P::plan.op2[2],
+                                                        P::plan.op2[3]>{});
+        }
+        else
+            return gcc_permute_single<E, Pout>(a, b, gcc_indices<m...>{});
+    }
+    else
+        return gcc_permute_single<E, Pout>(a, b, gcc_indices<m...>{});
+}
+
+template <typename E, size_t Pout, typename V, int... m>
+KFR_INTRINSIC gcc_vec<E, Pout> gcc_permute_single(const V& a, const V& b, gcc_indices<m...>)
+{
+    constexpr size_t K = gcc_lanes<V>;
+    using R            = gcc_vec<E, Pout>;
+#if __GNUC__ >= 12
+    return __builtin_shufflevector(a, b, m...);
+#else
+    // GCC < 12 does not recognize ins, or zip/ext on pairs of lanes, and falls back to tbl
+    constexpr int ins_lane = gcc_ins_lane<K, m...>();
+    if constexpr (Pout == K && sizeof(E) < 8 && K % 2 == 0 && gcc_paired_lanes<m...>())
+    {
+        // pairs of adjacent lanes: permute as lanes twice as wide
+        using W  = typename std::conditional_t<sizeof(E) == 1, std::common_type<uint16_t>,
+                                              std::conditional_t<sizeof(E) == 2, std::common_type<uint32_t>,
+                                                                 std::common_type<uint64_t>>>::type;
+        using VW = gcc_vec<W, K / 2>;
