+template <typename E, size_t Pout, int... sel, size_t... I>
+KFR_INTRINSIC gcc_vec<E, Pout> gcc_blend(const gcc_vec<E, Pout>& first, const gcc_vec<E, Pout>& rest,
+                                         gcc_indices<sel...>, csizes_t<I...>)
+{
