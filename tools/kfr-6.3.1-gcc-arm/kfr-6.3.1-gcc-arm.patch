+// Two-step plans for 4 x 32-bit permutations. GCC maps a permutation to one instruction
+// (zip/uzp/trn/ext/rev64/dup/ins) when it matches one, otherwise it falls back to tbl with a constant
+// load (and register moves, since a two-register tbl needs consecutive registers). Clang finds two-instruction
+// sequences instead; this searches for one at compile time.
+struct gcc_perm4_plan
+{
+    bool direct = true; // single instruction, or no two-step plan found
+    int u = 0, v = 0;   // sources of step 1: 0 = a, 1 = b
+    int op1[4]{};
+    int s1 = 0, s2 = 0; // sources of step 2: 0 = a, 1 = b, 2 = result of step 1
+    int op2[4]{};
+};
+
+struct gcc_perm4_ops
+{
+    int count = 0;
+    int ops[48][4]{};
+    constexpr void add(int x0, int x1, int x2, int x3)
+    {
+        ops[count][0] = x0;
+        ops[count][1] = x1;
+        ops[count][2] = x2;
+        ops[count][3] = x3;
+        ++count;
+    }
+};
+
+constexpr gcc_perm4_ops gcc_perm4_single_ops()
+{
+    gcc_perm4_ops r;
+    r.add(0, 4, 1, 5); // zip1
+    r.add(2, 6, 3, 7); // zip2
+    r.add(0, 2, 4, 6); // uzp1
+    r.add(1, 3, 5, 7); // uzp2
+    r.add(0, 4, 2, 6); // trn1
+    r.add(1, 5, 3, 7); // trn2
+    r.add(1, 2, 3, 4); // ext
+    r.add(2, 3, 4, 5);
+    r.add(3, 4, 5, 6);
+    r.add(0, 1, 4, 5); // zip1 .2d
+    r.add(2, 3, 6, 7); // zip2 .2d
+    r.add(1, 0, 3, 2); // rev64
+    r.add(0, 1, 2, 3); // mov
+    for (int i = 0; i < 4; ++i)
+        r.add(i, i, i, i); // dup
+    for (int i = 0; i < 4; ++i)
+        for (int j = 0; j < 4; ++j)
+        {
+            int x[4] = { 0, 1, 2, 3 };
+            x[i]     = 4 + j; // ins
+            r.add(x[0], x[1], x[2], x[3]);
+        }
+    r.add(0, 1, 6, 7); // ins .d
+    r.add(6, 7, 2, 3);
+    r.add(4, 5, 2, 3);
+    r.add(2, 3, 2, 3); // dup .d
+    return r;
+}
+
+constexpr bool gcc_perm4_match(const int (&target)[4], const int (&lanes)[4])
+{
+    for (int j = 0; j < 4; ++j)
+        if (target[j] >= 0 && target[j] != lanes[j])
+            return false;
+    return true;
+}
+
+constexpr gcc_perm4_plan gcc_perm4_find(const int (&target)[4])
+{
+    constexpr gcc_perm4_ops ops = gcc_perm4_single_ops();
+    const int src[2][4]         = { { 0, 1, 2, 3 }, { 4, 5, 6, 7 } };
+    gcc_perm4_plan plan;
+    for (int u = 0; u < 2; ++u)
+        for (int v = 0; v < 2; ++v)
+            for (int o = 0; o < ops.count; ++o)
+            {
+                int t[4]{};
+                for (int j = 0; j < 4; ++j)
+                    t[j] = ops.ops[o][j] < 4 ? src[u][ops.ops[o][j]] : src[v][ops.ops[o][j] - 4];
+                if (gcc_perm4_match(target, t))
+                    return plan; // direct
+            }
+    for (int u = 0; u < 2; ++u)
+        for (int v = 0; v < 2; ++v)
+            for (int o1 = 0; o1 < ops.count; ++o1)
+            {
+                int t[4]{};
+                for (int j = 0; j < 4; ++j)
+                    t[j] = ops.ops[o1][j] < 4 ? src[u][ops.ops[o1][j]] : src[v][ops.ops[o1][j] - 4];
+                const int* srcs[3] = { src[0], src[1], t };
+                for (int s1 = 0; s1 < 3; ++s1)
+                    for (int s2 = 0; s2 < 3; ++s2)
+                    {
+                        if (s1 != 2 && s2 != 2)
+                            continue;
+                        for (int o2 = 0; o2 < ops.count; ++o2)
+                        {
+                            int r[4]{};
+                            for (int j = 0; j < 4; ++j)
+                                r[j] = ops.ops[o2][j] < 4 ? srcs[s1][ops.ops[o2][j]] : srcs[s2][ops.ops[o2][j] - 4];
+                            if (gcc_perm4_match(target, r))
+                            {
+                                plan.direct = false;
+                                plan.u      = u;
+                                plan.v      = v;
+                                plan.s1     = s1;
+                                plan.s2     = s2;
+                                for (int j = 0; j < 4; ++j)
+                                {
+                                    plan.op1[j] = ops.ops[o1][j];
+                                    plan.op2[j] = ops.ops[o2][j];
+                                }
+                                return plan;
+                            }
+                        }
+                    }
+            }
+    return plan;
+}
+
+template <int m0, int m1, int m2, int m3>
+struct gcc_perm4
+{
+    constexpr static int target[4]          = { m0, m1, m2, m3 };
+    constexpr static gcc_perm4_plan plan    = gcc_perm4_find(target);
+};
