+#if __GNUC__ < 12
+// true if indices come in pairs (2i, 2i+1) of adjacent lanes; undefined lanes match anything
+template <int... m>
+constexpr bool gcc_paired_lanes()
+{
+    constexpr int v[] = { m... };
+    for (size_t i = 0; i + 1 < sizeof...(m); i += 2)
+    {
+        if (v[i] >= 0 && v[i] % 2 != 0)
+            return false;
+        if (v[i + 1] >= 0 && v[i + 1] % 2 != 1)
+            return false;
+        if (v[i] >= 0 && v[i + 1] >= 0 && v[i + 1] != v[i] + 1)
+            return false;
+    }
+    return sizeof...(m) % 2 == 0;
+}
+
+template <int... m, size_t... I>
+constexpr auto gcc_pair_indices(gcc_indices<m...>, csizes_t<I...>)
+{
+    using ix = gcc_indices<m...>;
+    return gcc_indices<(ix::values[2 * I] >= 0       ? ix::values[2 * I] / 2
+                        : ix::values[2 * I + 1] >= 0 ? ix::values[2 * I + 1] / 2
+                                                     : -1)...>{};
+}
+
+// 0 if indices equal the lanes of a except one lane, 1 if the same holds for b, -1 otherwise
+template <size_t K, int... m>
+constexpr int gcc_ins_base()
+{
+    constexpr int v[] = { m... };
+    for (int base = 0; base < 2; ++base)
+    {
+        int diff = 0;
+        for (size_t i = 0; i < K; ++i)
+            if (v[i] >= 0 && v[i] != static_cast<int>(base * K + i))
+                ++diff;
+        if (diff <= 1)
+            return base;
+    }
+    return -1;
+}
+
+// the lane that differs, or -1 if there is no such single lane
+template <size_t K, int... m>
+constexpr int gcc_ins_lane()
+{
+    if constexpr (sizeof...(m) != K)
+        return -1;
+    else
+    {
+        constexpr int base = gcc_ins_base<K, m...>();
+        if (base < 0)
+            return -1;
+        constexpr int v[] = { m... };
+        for (size_t i = 0; i < K; ++i)
+            if (v[i] >= 0 && v[i] != static_cast<int>(base * K + i))
+                return static_cast<int>(i);
+        return -1;
+    }
+}
+#endif
